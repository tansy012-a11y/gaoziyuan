# -*- coding: utf-8 -*-
"""
Mini DAG Engine

特性：
1. 自动依赖解析（DAG）
2. 懒执行（Lazy Evaluation）
3. 结果缓存（Memoization）
4. 并行执行（线程池）
5. 增量更新（只重新计算受影响节点）

一句话：像“写数学表达式一样写程序”
"""

from typing import Callable, Any, Dict, List
from concurrent.futures import ThreadPoolExecutor
import threading


# ===============================
# 1. 节点定义
# ===============================
class Node:
    def __init__(self, func: Callable, *inputs, name=None):
        self.func = func
        self.inputs = inputs
        self.name = name or f"Node_{id(self)}"
        self._value = None
        self._computed = False
        self._lock = threading.Lock()

    def compute(self):
        with self._lock:
            if self._computed:
                return self._value

            values = [
                x.compute() if isinstance(x, Node) else x
                for x in self.inputs
            ]

            self._value = self.func(*values)
            self._computed = True
            return self._value

    def reset(self):
        """递归清除缓存（用于增量更新）"""
        with self._lock:
            self._computed = False
            self._value = None

        for x in self.inputs:
            if isinstance(x, Node):
                x.reset()

    def __repr__(self):
        return f"<{self.name}>"


# ===============================
# 2. 构建工具（语法糖）
# ===============================
def op(func):
    """装饰器：把普通函数变成计算节点构造器"""
    def wrapper(*args, **kwargs):
        return Node(func, *args, name=func.__name__)
    return wrapper


# ===============================
# 3. 常用操作
# ===============================
@op
def add(a, b):
    return a + b

@op
def mul(a, b):
    return a * b

@op
def square(x):
    return x * x

@op
def relu(x):
    return max(0, x)


# ===============================
# 4. 并行执行器
# ===============================
class Executor:
    def __init__(self, max_workers=4):
        self.pool = ThreadPoolExecutor(max_workers=max_workers)

    def run(self, node: Node):
        return node.compute()

    def run_async(self, nodes: List[Node]):
        futures = [self.pool.submit(n.compute) for n in nodes]
        return [f.result() for f in futures]


# ===============================
# 5. 示例：构建复杂计算图
# ===============================
if __name__ == "__main__":

    # 构建表达式：
    # z = relu((a + b)^2 + (a * b))

    a = Node(lambda: 3, name="a")
    b = Node(lambda: 5, name="b")

    c1 = add(a, b)        # a + b
    c2 = square(c1)       # (a + b)^2
    c3 = mul(a, b)        # a * b
    z = relu(add(c2, c3)) # relu(...)

    executor = Executor()

    # 第一次计算
    print("第一次计算:", executor.run(z))

    # 修改输入（模拟增量更新）
    a.func = lambda: 10
    z.reset()

    print("修改后计算:", executor.run(z))
